# Web3Forms — get a free key at https://web3forms.com (use OASolutions26@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Google Calendar Appointment Schedule — create at https://calendar.google.com
# 1. Sign in as OASolutions26@gmail.com
# 2. Create → Appointment schedule → name it "Discovery call" (30 min)
# 3. Copy the public booking page URL and paste below
# Example: https://calendar.app.google/xxxxxxxx or https://calendar.google.com/calendar/appointments/...
VITE_GOOGLE_CALENDAR_BOOKING_URL=

# Analytics (optional — set one or both after launch)
# Plausible: https://plausible.io — privacy-friendly, recommended
VITE_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
